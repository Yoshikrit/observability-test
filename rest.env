APP_ENV=development
APP_PORT=8080

# service name "postgres", not localhost - containers reach each other by service name
DATABASE_URL=postgres://postgres:postgres@postgres:5432/observability_test?sslmode=disable

LOG_LEVEL=info
ACCESS_LOG_ENABLED=true

# Alloy exists now - spans are pushed here via OTLP, forwarded to Tempo.
TRACE_OTLP_ENDPOINT=alloy:4317

# local debugging only: also print spans to stdout.
TRACE_CONSOLE_EXPORT_ENABLED=false
